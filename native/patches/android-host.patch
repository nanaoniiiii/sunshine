 namespace sunshine_callbacks {
+    void networkFeedback(void* channel, std::string_view payload) {
+        auto report=sunshine_android::parse_fec_report(payload);
+        std::lock_guard lock(sunshine_android::video_mutex);
+        for (auto& [id,s]:sunshine_android::video_sessions) if(s->channel==channel) {
+            if (!report) { ++s->network.rejected_reports; return; }
+            auto now=sunshine_android::video_now_ms();
+            if (!s->network.feedback(*report,s->configured_fps,now)) return;
+            auto target=s->desired==s->applied?s->network.react(*report,s->applied,sunshine_android::video_policy.floor(s->negotiated),now):0;
+            if(target) { s->desired=s->override_kbps=target; ++s->revision; }
+            return;
+        }
+    }
+    void networkRtt(void* channel,int milliseconds) {
+        if(milliseconds<0 || milliseconds>10000) return;
+        std::lock_guard lock(sunshine_android::video_mutex);
+        for(auto& [id,s]:sunshine_android::video_sessions) if(s->channel==channel) {
+            auto now=sunshine_android::video_now_ms();
+            s->network.rtt=milliseconds; s->network.rtt_at=now;
+            if(s->desired==s->applied && sunshine_android::VideoClock::now()-s->last_output<std::chrono::seconds(2)) {
+                int ceiling=sunshine_android::video_policy.ceiling(s->negotiated);
+                auto target=s->network.recover(s->applied,ceiling,now);
+                if(target) { s->desired=s->override_kbps=target; ++s->revision; }
+            }
+            return;
+        }
+    }
+    std::pair<int,int> networkSendPolicy(void* channel,int default_fec,int negotiated_kbps,uint32_t frame) {
+        std::lock_guard lock(sunshine_android::video_mutex);
+        for(auto& [id,s]:sunshine_android::video_sessions) if(s->channel==channel) {
+            s->network.last_sent_frame=frame; s->network.has_sent_frame=true; s->network.last_sent_at=sunshine_android::video_now_ms();
+            return {s->network.fec,sunshine_android::pacing_budget(std::max(1,std::min(s->network.total_budget,sunshine_android::nominal_budget(s->applied,s->network.fec))))};
+        }
+        return {default_fec,sunshine_android::pacing_budget(std::max(1,sunshine_android::nominal_budget(negotiated_kbps,default_fec)))};
+    }
